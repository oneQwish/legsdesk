@echo off
rem ==========================================================================================
rem  Запуск всех подключений из папки «подключения» по очереди.
rem  Для расписания: Планировщик заданий Windows → Создать задачу → Действие: этот файл.
rem  Пароли и ключ — в файле «секреты.bat» рядом (создайте из «секреты.пример.bat»), в git его не кладите.
rem  Журналы — в папке «подключения\журналы».
rem  Код возврата — наибольший из кодов подключений: 0 — всё хорошо, 1 — есть строки с ошибками,
rem  2 — ошибка в настройках, 3 — нет связи, 4 — подключение ещё выполнялось (запуск пропущен),
rem  5 — неожиданная ошибка (подробности в журнале).
rem ==========================================================================================
chcp 65001 >nul
set PYTHONUTF8=1
setlocal EnableDelayedExpansion
cd /d "%~dp0"
if exist "секреты.bat" call "секреты.bat"
set RESULT=0
for %%F in ("подключения\*.toml") do (
    echo.
    python lawdesk_connect.py запустить "%%F"
    if !ERRORLEVEL! GTR !RESULT! set RESULT=!ERRORLEVEL!
)
exit /b %RESULT%
