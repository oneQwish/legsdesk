@echo off
rem ==========================================================================================
rem  Запуск всех подключений из папки «подключения» по очереди.
rem  Для расписания: Планировщик заданий Windows → Создать задачу → Действие: этот файл.
rem  Пароли и ключ — в файле «секреты.bat» рядом (создайте из «секреты.пример.bat»), в git его не кладите.
rem  Журналы — в папке «подключения\журналы». Код возврата: 0 — всё хорошо, иначе — смотрите журнал.
rem ==========================================================================================
chcp 65001 >nul
cd /d "%~dp0"
if exist "секреты.bat" call "секреты.bat"
set ИТОГ=0
for %%F in ("подключения\*.toml") do (
    echo.
    python lawdesk_connect.py запустить "%%F"
    if errorlevel 1 set ИТОГ=1
)
exit /b %ИТОГ%
