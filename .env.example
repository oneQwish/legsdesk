# ================================================================================================
#  Секреты и то, что отличается от сервера к серверу. Все обычные настройки (AD, хранилище,
#  часовой пояс, лимиты, интерфейс) — в backend/settings.toml, с пояснениями.
#  Любая строка LAWDESK_<ИМЯ>=… здесь главнее settings.toml — не дублируйте настройки без нужды.
# ================================================================================================

# Пароль базы данных (docker-compose)
POSTGRES_PASSWORD=

# Подпись сессий: случайная строка ≥ 32 символов (python3 -c "import secrets;print(secrets.token_hex(32))")
LAWDESK_SECRET_KEY=

# Пароль пользователя документооборота ([storage] docflow_user в settings.toml), если storage_backend = "docflow"
LAWDESK_DOCFLOW_PASSWORD=
