# Пароль БД (docker-compose)
POSTGRES_PASSWORD=

# Подпись сессий: случайная строка ≥ 32 символов (python -c "import secrets;print(secrets.token_hex(32))")
LAWDESK_SECRET_KEY=

# Вход: ldap (боевой) | dev (любой логин, пароль LAWDESK_DEV_PASSWORD — только для пробы!)
LAWDESK_AUTH_MODE=ldap
LAWDESK_SESSION_HOURS=12

# Active Directory
LAWDESK_LDAP_URL=ldaps://dc01.company.local
LAWDESK_LDAP_DOMAIN=COMPANY
LAWDESK_LDAP_BASE_DN=DC=company,DC=local
# Группы AD → роли (DN группы целиком или его начало «CN=…»)
LAWDESK_LDAP_GROUP_ADMIN=CN=Lawdesk-Admins
LAWDESK_LDAP_GROUP_LAWYER=CN=Lawdesk-Lawyers
LAWDESK_LDAP_GROUP_VIEWER=CN=Lawdesk-Viewers

# Часовой пояс компании: от него считается «сегодня» для сроков и просрочек
LAWDESK_TIMEZONE=Europe/Moscow
# Наибольший размер загружаемого документа, МБ (не больше client_max_body_size в frontend/nginx.conf)
LAWDESK_MAX_UPLOAD_MB=200
# Защита от перебора паролей: неудачных попыток до блокировки входа на 15 минут
LAWDESK_LOGIN_MAX_FAILURES=5

# Хранилище файлов: local (том storage) | docflow (1С:Документооборот, когда ИТ опубликует HTTP-сервис)
LAWDESK_STORAGE_BACKEND=local
LAWDESK_DOCFLOW_URL=
LAWDESK_DOCFLOW_USER=
LAWDESK_DOCFLOW_PASSWORD=
